BUFFER_ACCESS_TOKEN=

# ─── Content Studio (Venture B) ──────────────────────────────────────────────

# Google Drive — /PodcastNotes/ folder hierarchy
# Create manually or via scripts/setup_content_studio_drive.py (Sprint 2+)
DRIVE_PODCAST_ROOT_ID=          # /PodcastNotes/ root folder
DRIVE_PODCAST_ORDERS_ID=        # /PodcastNotes/01-orders/
DRIVE_PODCAST_REVIEW_ID=        # /PodcastNotes/02-review/
DRIVE_PODCAST_DELIVERED_ID=     # /PodcastNotes/03-delivered/

# Review & delivery
HUMAN_REVIEW_EMAIL=             # Email address for review notifications
CONTENT_STUDIO_AUTO_APPROVE=false           # Set true after 20 validated deliveries
CONTENT_STUDIO_AUTO_APPROVE_AFTER=20
CONTENT_STUDIO_SLACK_CHANNEL=#content-studio-review

# Brand voice cache
BRAND_VOICE_CACHE_ENABLED=true

# ─── Marketing Audit (Venture C) ─────────────────────────────────────────────

# Path to the ai-marketing-claude repo (needed for scraping + PDF generation)
# Default: sibling directory C:\Projects\AI\ai-marketing-claude
AI_MARKETING_CLAUDE_PATH=C:\Projects\AI\ai-marketing-claude

# Google Drive — /MarketingAudits/ folder
DRIVE_AUDIT_ROOT_ID=            # /MarketingAudits/ root folder

# Review
AUDIT_AUTO_APPROVE=false
COMPETITOR_MAX=3

# ─── Sprint 6 ────────────────────────────────────────────────────────────────

# Gemini / Google AI
GOOGLE_AI_API_KEY=

# OpenAI (DALL-E 3 fallback)
OPENAI_API_KEY=

# Claude API
ANTHROPIC_API_KEY=

# Redis Cloud
REDIS_URL=

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=

# LangSmith observability
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=etsyshop
LANGCHAIN_TRACING_V2=true
