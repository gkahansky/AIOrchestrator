DRIVE_02_SUBJECTS_ID=
DRIVE_03_IMAGES_ID=
DRIVE_04_PACKAGES_ID=
DRIVE_05_REVIEW_ID=
DRIVE_05_REVIEW_PENDING_ID=
DRIVE_05_REVIEW_APPROVED_ID=
DRIVE_05_REVIEW_REJECTED_ID=
DRIVE_06_AUDIT_ID=
DRIVE_06_AUDIT_DRAFTS_ID=
DRIVE_06_AUDIT_PUBLISHED_ID=
DRIVE_07_PROMO_ID=

# ─── Sprint 2 ────────────────────────────────────────────────────────────────

# Etsy OAuth
ETSY_API_KEY=
ETSY_API_SECRET=
